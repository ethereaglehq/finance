# --- required in production ---
FINLEX_ENV=production
FINLEX_SECRET_KEY=replace-with-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
FINLEX_COOKIE_SECURE=true                            # set false only for plain-http local testing
POSTGRES_PASSWORD=change-me

# --- database (default: SQLite file next to the backend) ---
# FINLEX_DATABASE_URL=postgresql+psycopg://finlex:change-me@localhost:5432/finlex

# --- market data: auto (live with labelled synthetic fallback) | live | synthetic (offline demo) ---
FINLEX_MARKET_DATA_MODE=auto
FINLEX_QUOTE_REFRESH_MINUTES=15
# Comma-separated RSS feeds; empty disables live news (labelled samples are shown instead)
# FINLEX_NEWS_FEEDS=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.moneycontrol.com/rss/marketreports.xml

# --- optional: Anthropic Claude for Ask FinLex / summaries (users must also opt in) ---
# FINLEX_ANTHROPIC_API_KEY=sk-ant-...
# FINLEX_LLM_MODEL=claude-opus-5-5
# FINLEX_LLM_EFFORT=medium

# --- operations ---
FINLEX_SCHEDULER_ENABLED=true        # disable when running >1 replica; use `python -m app.cli refresh` from cron
FINLEX_ADMIN_EMAILS=                 # may upload AMC fund-holdings disclosures
# FINLEX_CORS_ORIGINS=https://your-frontend.example   # only if the SPA is served from another origin
